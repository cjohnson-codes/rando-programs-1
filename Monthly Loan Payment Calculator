def calcPmt(P0, r, k, N):
    denominator = (1 - (1 + r/k) ** (-N*k)) / (r/k)
    d = P0 / denominator
    return d

def main():
    P0 = float(input("Amount financed: "))
    r = float(input("Annual interest rate (decimal): "))
    k = int(input("Compounds per year: "))
    N = float(input("Number of years: "))

    payment = calcPmt(P0, r, k, N)

    print(f"Monthly payment: ${payment:.2f}")

main()