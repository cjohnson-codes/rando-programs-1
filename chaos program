def chaos(k, x, n):
    for i in range(n):
        x = k * x * (1 - x)
        print(f"Iteration {i+1}: {x}")

def main():
    k = float(input("Enter k value: "))
    x = float(input("Enter initial x value: "))
    n = int(input("Enter number of iterations: "))

    chaos(k, x, n)

main()